---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { categories, getExcerpt, getPostCategory } from '../../lib/content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Smart Home Blog" description="All Smart Home Tips articles, buying guides, and setup advice.">
  <header class="archive-header">
    <p class="eyebrow">Full archive</p>
    <h1>Smart Home Blog</h1>
    <p>Browse every buying guide, comparison, setup tutorial, and troubleshooting article.</p>
  </header>

  <nav class="category-nav" aria-label="Smart home categories">
    {categories.map((category) => <a href={`/categories/${category.slug}`}>{category.label}</a>)}
  </nav>

  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <article>
          <p class="eyebrow">{getPostCategory(post).label}</p>
          <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
          <p>{getExcerpt(post)}</p>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}
          </time>
        </article>
      </li>
    ))}
  </ul>
</Base>

<style>
  .archive-header { max-width: 760px; margin-bottom: 1.5rem; }
  .archive-header h1 { margin: 0.25rem 0 0.5rem; font-size: 2.2rem; line-height: 1.08; }
  .archive-header p { color: var(--muted); }
  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 2rem;
  }
  .category-nav a {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.65rem;
    background: #fff;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .post-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    list-style: none;
  }
  .post-list article {
    height: 100%;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1rem;
    background: #fff;
  }
  h2 { font-size: 1.05rem; line-height: 1.3; margin: 0.25rem 0 0.45rem; }
  article p:not(.eyebrow) { color: var(--muted); font-size: 0.94rem; }
  time { display: block; margin-top: 0.75rem; color: var(--muted); font-size: 0.86rem; }
</style>
