---
import ArticlePage from '../../components/ArticlePage.astro';
import { getCollection, render } from 'astro:content';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && !data.redirectTo && !data.canonicalPath);
  return posts.map((post) => ({ params: { id: post.id }, props: { post, posts } }));
}

const { post, posts } = Astro.props;
const { Content } = await render(post);
---

<ArticlePage {post} {posts}>
  <Content />
</ArticlePage>
