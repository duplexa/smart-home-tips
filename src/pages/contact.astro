---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact Smart Home Tips"
  description="Contact Smart Home Tips for editorial corrections, privacy questions, and smart-home guide feedback."
>
  <section class="page">
    <p class="eyebrow">Contact</p>
    <h1>Contact Smart Home Tips</h1>
    <p>
      For corrections, privacy questions, partnership queries, or feedback on a smart-home guide, email:
      <a href="mailto:hello@smarthomestips.com">hello@smarthomestips.com</a>.
    </p>
    <p>
      We are especially interested in UK availability changes, discontinued products, subscription price changes,
      safety corrections, and practical setup notes from readers using smart-home kit in UK homes.
    </p>
  </section>
</Base>

<style>
  .page { max-width: 760px; }
  h1 { margin: 0.25rem 0 1rem; font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.02; }
  p { margin-bottom: 1rem; color: var(--muted); font-size: 1.03rem; }
</style>
