---
import ArticlePage from '../components/ArticlePage.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => !data.draft && !data.redirectTo);
  const posts = allPosts.filter((post) => !post.data.canonicalPath);
  return allPosts
    .filter((post) => post.data.canonicalPath)
    .map((post) => ({
      params: { slug: post.data.canonicalPath!.replace(/^\/|\/$/g, '') },
      props: { post, posts },
    }));
}

const { post, posts } = Astro.props;
---

<ArticlePage {post} {posts} />
