---
interface Props {
  title: string;
  description: string;
  date?: Date;
  author?: string;
  image?: string;
  type: 'website' | 'article';
  breadcrumbs?: Array<{ name: string; url?: string }>;
  rankedItems?: Array<{ name: string; url?: string; description?: string }>;
  faqs?: Array<{ question: string; answer: string }>;
}

const { title, description, date, author, image, type, breadcrumbs, rankedItems, faqs } = Astro.props;
const canonicalPathname = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const url = new URL(canonicalPathname, Astro.site).href;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Smart Home Tips',
  url: Astro.site?.href,
  description: 'UK smart-home buying guides, setup advice, and practical automation tips.',
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url,
  ...(date && { datePublished: date.toISOString() }),
  ...(date && { dateModified: date.toISOString() }),
  author: { '@type': 'Organization', name: author ?? 'Smart Home Tips editorial team' },
  publisher: { '@type': 'Organization', name: 'Smart Home Tips' },
  ...(image && { image }),
};

const breadcrumbSchema = breadcrumbs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.name,
        ...(crumb.url && { item: new URL(crumb.url, Astro.site).href }),
      })),
    }
  : undefined;

const itemListSchema = rankedItems?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: title,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: rankedItems.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        ...(item.url && { url: item.url }),
        ...(item.description && { description: item.description }),
      })),
    }
  : undefined;

const faqSchema = faqs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    }
  : undefined;

const schema = [type === 'article' ? articleSchema : websiteSchema, breadcrumbSchema, itemListSchema, faqSchema].filter(Boolean);
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
