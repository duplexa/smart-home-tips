---
interface Props {
  title: string;
  description: string;
  date?: Date;
  author?: string;
  image?: string;
  type: 'website' | 'article';
}

const { title, description, date, author, image, type } = Astro.props;
const url = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site).href;

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Smart Home Tips',
  url: Astro.site?.href,
  description: 'UK smart-home buying guides, setup advice, and practical automation tips.',
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url,
  ...(date && { datePublished: date.toISOString() }),
  ...(date && { dateModified: date.toISOString() }),
  author: { '@type': 'Organization', name: author ?? 'Smart Home Tips editorial team' },
  publisher: { '@type': 'Organization', name: 'Smart Home Tips' },
  ...(image && { image }),
};

const schema = type === 'article' ? articleSchema : websiteSchema;
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
